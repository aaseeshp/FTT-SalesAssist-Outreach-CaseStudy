# Copy to .env (in this folder or its parent). Real environment variables take precedence.

# Which LLM to use: auto (Claude, then Gemini, then templates) | claude | gemini | template
LLM_PROVIDER=auto

# --- Claude (default) ------------------------------------------------------------------------
# Auth: run `ant auth login` once (recommended - no key stored here), or set ANTHROPIC_API_KEY.
# ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_FALLBACK_MODELS=claude-haiku-5-5

# --- Gemini (optional) -----------------------------------------------------------------------
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite

# Orchestration: auto (CrewAI agents when a model is available) | crew | gemini | template
DRAFTER=auto
# Pre-compute drafts for every advisor at start-up so the email panel opens instantly
WARM_CACHE=true
LLM_TIMEOUT_S=60
